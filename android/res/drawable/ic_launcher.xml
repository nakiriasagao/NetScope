<?xml version="1.0" encoding="utf-8"?>
<!--
  NetScope 图标：深色底 + 中心节点与四条连线（网络拓扑意象）
  使用矢量图，无需准备多套 PNG，任意分辨率都清晰。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景 -->
    <path
        android:fillColor="#0B1220"
        android:pathData="M0,0h108v108h-108z" />

    <!-- 连线 -->
    <path
        android:strokeColor="#38BDF8"
        android:strokeWidth="3"
        android:strokeAlpha="0.85"
        android:pathData="M54,54 L26,30 M54,54 L82,30 M54,54 L26,80 M54,54 L82,80" />

    <!-- 中心节点 -->
    <path
        android:fillColor="#34D399"
        android:pathData="M54,46 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />

    <!-- 外围节点 -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M26,26 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M82,26 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M26,80 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#F472B6"
        android:pathData="M82,80 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
</vector>
